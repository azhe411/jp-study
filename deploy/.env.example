# 复制为 deploy/.env 后填写；.env 永不入 Git。
POSTGRES_PASSWORD=请替换为随机长串
JWT_SECRET=请替换为至少32位的随机长串
# 注册开关：建好自己的账号后改为 false
ALLOW_REGISTER=true
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_LEVEL=info
APP_VERSION=0.3.1
# 契约 §13：服务端仍兼容的最低客户端版本（semver）。只在做了不兼容旧客户端的变更时才设置/调高；留空 = 不限制
MIN_CLIENT_VERSION=
# DeepSeek（只存服务端）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
