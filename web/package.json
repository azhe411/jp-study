{
  "name": "jp-study-web",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "description": "一駅 · 前端（React + Vite + PWA）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "build:android": "tsc -b && vite build --mode android",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && .\\gradlew.bat -g D:/DevTools/Gradle assembleDebug",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-updater": "^8.54.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vosk-browser": "^0.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
