{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "一駅",
  "mainBinaryName": "jp-study",
  "version": "0.14.1",
  "identifier": "top.azclient.jp",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "一駅",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://jpd.azclient.top:8443 https://jp.azclient.top; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; frame-src https://player.bilibili.com https://www.bilibili.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "jp-study",
    "shortDescription": "一駅 · 每天一站，学到终点",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1MjkzRDZDMzFCMkJDMDAKUldRQXZMSXhiRDBwaFJEMVpUaXo0Z0FCalgrbGdTY3dUSlpOQnZ4WUNaQThxWTBpYVd6MUFlem8K",
      "endpoints": [
        "https://jpd.azclient.top:8443/api/v1/app/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": true
    }
  }
}
